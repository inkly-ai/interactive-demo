{
  "$schema": "https://cdn.jsdelivr.net/npm/@inkly-org/interactive-demo/dist/schema/demo.config.json",
  "id": "tourExample0",
  "version": 1,
  "title": "A tour of interactive-demo",
  "subtitle": "Three screens, three hotspots, one static build.",
  "chrome": {
    "hideHeader": false,
    "hideControls": false,
    "controls": "full",
    "mobileFooterMessage": true,
    "autoplay": false,
    "branding": true
  },
  "chapters": [
    {
      "id": "intro",
      "title": "Intro",
      "stepIds": [
        "cover-intro"
      ]
    },
    {
      "id": "tour",
      "title": "Tour",
      "stepIds": [
        "demos",
        "player",
        "editor"
      ]
    },
    {
      "id": "outro",
      "title": "Wrap up",
      "stepIds": [
        "cover-outro"
      ]
    }
  ],
  "steps": [
    {
      "kind": "cover",
      "id": "cover-intro",
      "widgets": [
        {
          "type": "headline",
          "id": "headline-intro",
          "title": "A tour of interactive-demo",
          "description": "Capture a click-through of your product, add hotspots in a local editor, and ship it as a static page or a hosted link.",
          "cta": {
            "label": "Start the tour",
            "action": {
              "type": "next"
            },
            "animation": "shimmer"
          },
          "image": {
            "src": "assets/03-editor.png",
            "alt": "The local editor with the slide strip open",
            "naturalWidth": 1440,
            "naturalHeight": 900,
            "position": "right",
            "layout": "hero"
          },
          "secondaryCta": {
            "label": "Get the CLI",
            "action": {
              "type": "url",
              "href": "https://github.com/inkly-ai/interactive-demo"
            },
            "animation": "none",
            "background": "#f8f8f8",
            "textColor": "#1f1f1f"
          }
        }
      ],
      "advance": {
        "trigger": "click"
      }
    },
    {
      "kind": "content",
      "id": "demos",
      "label": "Your demos",
      "background": {
        "type": "image",
        "src": "assets/01-demos.png",
        "naturalWidth": 1440,
        "naturalHeight": 900,
        "alt": "The dev server listing three demos"
      },
      "script": "interactive-demo dev lists every demo in the project. Each one has a link to the player and an Edit link.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "demos-edit",
          "type": "message",
          "variant": "pointer",
          "x": 0.207,
          "y": 0.096,
          "text": "Click Edit to open a demo in the editor."
        }
      ]
    },
    {
      "kind": "content",
      "id": "player",
      "label": "The player",
      "background": {
        "type": "image",
        "src": "assets/02-player.png",
        "naturalWidth": 1440,
        "naturalHeight": 900,
        "alt": "The player showing a cover step"
      },
      "script": "This is what viewers see: a cover, then your screens with hotspots. The Built with Inkly badge sits in the corner and can be turned off.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "player-start",
          "type": "message",
          "variant": "pointer",
          "x": 0.5,
          "y": 0.607,
          "text": "A cover step with a headline and a button."
        }
      ]
    },
    {
      "kind": "content",
      "id": "editor",
      "label": "The editor",
      "background": {
        "type": "image",
        "src": "assets/03-editor.png",
        "naturalWidth": 1440,
        "naturalHeight": 900,
        "alt": "The editor with the slide strip on the right"
      },
      "script": "The editor runs locally and saves straight to demo.config.json. Add hotspots, captions and narration, then build.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "editor-strip",
          "type": "message",
          "variant": "pointer",
          "x": 0.896,
          "y": 0.325,
          "text": "Steps live in the slide strip; pick one to edit it."
        }
      ]
    },
    {
      "kind": "cover",
      "id": "cover-outro",
      "widgets": [
        {
          "type": "headline",
          "id": "headline-outro",
          "title": "That's the whole loop",
          "description": "Capture, annotate, build, embed. Publish once with a single command to get a shareable link.",
          "cta": {
            "label": "Replay",
            "action": {
              "type": "restart"
            },
            "animation": "shimmer"
          },
          "image": {
            "src": "assets/02-player.png",
            "alt": "The player showing the finished demo",
            "naturalWidth": 1440,
            "naturalHeight": 900,
            "position": "left",
            "layout": "hero"
          },
          "secondaryCta": {
            "label": "Try Inkly",
            "action": {
              "type": "url",
              "href": "https://app.inklyai.dev"
            },
            "animation": "none",
            "background": "#f8f8f8",
            "textColor": "#1f1f1f"
          }
        }
      ],
      "advance": {
        "trigger": "click"
      }
    }
  ]
}
