{
  "name": "@inkly-org/interactive-demo",
  "version": "0.1.0",
  "description": "React player and schema for interactive product demos.",
  "keywords": [
    "interactive-demo",
    "product-demo",
    "product-tour",
    "walkthrough",
    "onboarding",
    "react",
    "player",
    "demo"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inkly-ai/interactive-demo.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/inkly-ai/interactive-demo#readme",
  "bugs": "https://github.com/inkly-ai/interactive-demo/issues",
  "type": "module",
  "sideEffects": [
    "./src/theme/styles.css",
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes/index.js",
      "require": "./dist/themes/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./player.js": "./dist/player.js",
    "./embed.js": "./dist/embed.js",
    "./schema/demo.config.json": "./dist/schema/demo.config.json",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/theme/styles.css dist/styles.css && node scripts/copy-fonts.mjs && node scripts/emit-json-schema.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsup": "^8.3.5",
    "zod-to-json-schema": "^3.25.2"
  }
}
